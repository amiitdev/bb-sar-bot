[Unit]
Description=BB + Pure SAR Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bb-sar-bot
Environment=PATH=/root/bb-sar-bot/venv/bin:/usr/bin
ExecStart=/root/bb-sar-bot/venv/bin/python3 -m uvicorn api:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
